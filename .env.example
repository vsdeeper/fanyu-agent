# 火山方舟（@ai-sdk/openai → Responses API）
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=deepseek-v4-flash-260425

# 高德 Web 服务 Key（控制台创建应用时服务平台选「Web服务」，勿用 NEXT_PUBLIC_）
AMAP_WEB_KEY=your-amap-web-service-key

# 本地会话 JSON 目录（仓库外；Windows 建议用正斜杠，避免 \a 被当成转义）
CHAT_STORE_DIR=D:/华为云盘/ai-agent/chats
