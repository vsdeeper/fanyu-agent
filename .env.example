# 聊天 Provider 选择：deepseek（默认，DeepSeek 直连）| ark（火山方舟）| zhipu（智谱 BigModel）
CHAT_PROVIDER=deepseek

# DeepSeek 直连（CHAT_PROVIDER=deepseek 时生效；Responses API，原生支持联网搜索无需开关）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://your-deepseek-base-url
# 场景自动选择模型（均须配置，缺失启动时报错；按最后一条用户消息复杂度自动路由）
DEEPSEEK_MODEL_PRO=your-deepseek-model-pro
DEEPSEEK_MODEL_LITE=your-deepseek-model-lite
DEEPSEEK_MODEL_MINI=your-deepseek-model-mini
# DeepSeek 思考强度（可选，默认 high）：none|minimal|low|medium|high|xhigh|max
# 默认模型实际映射：low→low, high→high, xhigh→high, max→max
DEEPSEEK_REASONING_EFFORT=high

# 火山方舟（CHAT_PROVIDER=ark 时作为主对话；识图 analyze_image 始终需下列 ARK_*；主对话生图可走方舟 Seedream 或老张 LAOZHANG_*）
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://your-ark-base-url
# 场景自动选择模型（填写控制台中的模型或接入点 ID；按最后一条用户消息复杂度自动路由）
ARK_MODEL_PRO=your-ark-model-pro
ARK_MODEL_LITE=your-ark-model-lite
ARK_MODEL_MINI=your-ark-model-mini

# 智谱 BigModel（CHAT_PROVIDER=zhipu 时作为主对话；Chat Completions 兼容端点，
# glm 主模型自带视觉直读图片；联网搜索经独立 Web Search API 由本地工具调用，
# 内置 web_search 工具与 function 工具互斥不可用；生图/识图底座仍依赖上方 ARK_*）
ZHIPU_API_KEY=your-zhipu-api-key
# 注意到 /v4 为止，SDK 自拼 /chat/completions
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 场景自动选择模型（均须配置；单一多模态模型时三项填同值即可）
ZHIPU_MODEL_PRO=your-zhipu-model-pro
ZHIPU_MODEL_LITE=your-zhipu-model-lite
ZHIPU_MODEL_MINI=your-zhipu-model-mini

# 老张 API（生图 gemini-3.1-flash-lite-image；Gemini generateContent 端点，BASE_URL 需含 /v1，
# 代码自拼 /models/{modelId}:generateContent；生图/改图统一走该端点，宽高比经 imageConfig 直传）
LAOZHANG_API_KEY=your-laozhang-api-key
LAOZHANG_BASE_URL=https://api2.laozhang.ai/v1

# Flux Art 聚合生图（二期接入；首版可不填）
# FLUX_ART_API_KEY=your-flux-art-api-key
# FLUX_ART_BASE_URL=https://your-flux-art-base-url

# 高德 Web 服务 Key（控制台创建应用时服务平台选「Web服务」，勿用 NEXT_PUBLIC_）
AMAP_WEB_KEY=your-amap-web-service-key

# 会话 SQLite 目录（项目内；内含 chats.db，WAL 下可能另有 -wal/-shm）
CHAT_STORE_DIR=./data/chats
# 云盘备份路径（手动 sync:chats:push / sync:chats:pull 对端；非运行时目录）
CHAT_SYNC_REMOTE_DIR=/path/to/cloud-backup/chats
