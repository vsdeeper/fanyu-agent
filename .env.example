# 火山方舟（@ai-sdk/openai → Responses API）
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=deepseek-v4-flash-260425
# 方舟 Seedream 生图接入点（POST /images/generations）
ARK_IMAGE_MODEL_ID=doubao-seedream-4-0-250828

# Flux Art 聚合生图（二期接入；首版可不填）
# FLUX_ART_API_KEY=your-flux-art-api-key
# FLUX_ART_BASE_URL=https://open-api.flux-art.ai/openapi/v1

# 高德 Web 服务 Key（控制台创建应用时服务平台选「Web服务」，勿用 NEXT_PUBLIC_）
AMAP_WEB_KEY=your-amap-web-service-key

# 会话 SQLite 目录（仓库外；内含 chats.db，WAL 下可能另有 -wal/-shm；Windows 建议正斜杠）
CHAT_STORE_DIR=D:/华为云盘/ai-agent/chats
