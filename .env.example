# 聊天 Provider 选择：deepseek（默认，DeepSeek 直连）| ark（火山方舟）
CHAT_PROVIDER=deepseek

# DeepSeek 直连（CHAT_PROVIDER=deepseek 时生效；Responses API，原生支持联网搜索无需开关）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 场景自动选择模型（均可缺省，默认均为 deepseek-v4-flash；按最后一条用户消息复杂度自动路由）
DEEPSEEK_MODEL_PRO=deepseek-v4-flash
DEEPSEEK_MODEL_LITE=deepseek-v4-flash
DEEPSEEK_MODEL_MINI=deepseek-v4-flash
# DeepSeek 思考强度（可选，默认 high）：none|minimal|low|medium|high|xhigh|max
# deepseek-v4-flash 实际映射：low→low, high→high, xhigh→high, max→max
DEEPSEEK_REASONING_EFFORT=high

# 火山方舟（CHAT_PROVIDER=ark 时生效；@ai-sdk/openai → Responses API）
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 场景自动选择模型（均可缺省，默认值如下；按最后一条用户消息复杂度自动路由）
ARK_MODEL_PRO=doubao-seed-2-0-pro
ARK_MODEL_LITE=doubao-seed-2-0-lite
ARK_MODEL_MINI=doubao-seed-2-0-mini
# 方舟 Seedream 生图接入点（POST /images/generations）
ARK_IMAGE_MODEL_ID=doubao-seedream-4-0-250828

# Flux Art 聚合生图（二期接入；首版可不填）
# FLUX_ART_API_KEY=your-flux-art-api-key
# FLUX_ART_BASE_URL=https://open-api.flux-art.ai/openapi/v1

# 高德 Web 服务 Key（控制台创建应用时服务平台选「Web服务」，勿用 NEXT_PUBLIC_）
AMAP_WEB_KEY=your-amap-web-service-key

# 会话 SQLite 目录（仓库外；内含 chats.db，WAL 下可能另有 -wal/-shm；Windows 建议正斜杠）
CHAT_STORE_DIR=D:/华为云盘/ai-agent/chats
